<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="classe">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="alunno" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nome" type="xs:string"/>
              <xs:element name="cognome" type="xs:string"/>
              <xs:element name="dataN" type="xs:string"/>
              <xs:element name="computer">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="codice" type="xs:string"/>
                    <xs:element name="dataA" type="xs:string"/>
                    <xs:element name="dataU" type="xs:string"/>
                  </xs:sequence>
                  <xs:attribute name="tipo" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
